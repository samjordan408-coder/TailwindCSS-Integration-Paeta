{
  "id": "contact-us",
  "wrapperClass": "font-sans bg-white pb-12",

  "header": {
    "title": "Contact Us",
    "class": "bg-[#0d3f78] text-white text-center py-6 mb-12 text-3xl"
  },

  "layoutClass": "max-w-6xl mx-auto flex gap-20 px-10",

  "form": {
    "fields": [
      { "type": "text", "placeholder": "Your Name" },
      { "type": "email", "placeholder": "Email Address" },
      { "type": "text", "placeholder": "Subject" }
    ],
    "textarea": {
      "placeholder": "Message"
    },
    "button": {
      "text": "Send Message"
    }
  },

  "info": {
    "title": "Get In Touch",
    "description": "Have questions or need assistance? Our friendly team is ready to help, reach out to us today!",

    "items": [
      {
        "icon": "./images/contact.png",
        "title": "Call Us",
        "text": "(049) 557 0006"
      },
      {
        "icon": "./images/email.png",
        "title": "Email Us",
        "text": "[email protected]"
      },
      {
        "icon": "./images/web.png",
        "title": "Website",
        "text": "www.paetebank.ph"
      },
      {
        "icon": "./images/address.png",
        "title": "Address",
        "text": "J. Rizal corner J.V. Quesada Streets, Brgy. Ilaya del Sur, Paete, Laguna, 4016"
      }
    ],

    "social": [
      { "icon": "./images/FB.png", "url": "https://www.facebook.com/JORDAN.SAMSON.F" },
      { "icon": "./images/X.png", "url": "https://www.facebook.com/JORDAN.SAMSON.F" }
    ]
  }
}